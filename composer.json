{
    "name": "cerberos/moneybird",
    "description": "Moneybird API",
    "type": "library",
    "keywords": [
        "api",
        "php",
        "moneybird"
    ],
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Cerberos\\Moneybird\\": "src/Cerberos/Moneybird"
        }
    },
    "authors": [
        {
            "name": "Marius van Zundert",
            "email": "marius.vanzundert@cerberos.dev"
        },
        {
            "name": "Ruud Lambregts",
            "email": "ruud.lambregts@cerberos.dev"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.2.5",
        "psr/http-client": "^1.0"
    },
    "require-dev": {
        "laravel/pint": "^1.21",
        "phpspec/prophecy-phpunit": "^2.0",
        "symfony/var-dumper": "^7.0",
        "pestphp/pest": "^3.8",
        "pestphp/pest-plugin-drift": "^3.0",
        "pestphp/pest-plugin-type-coverage": "^3.5",
        "rector/rector": "^2.0"
    },
    "scripts": {
        "coverage": "pest --compact --coverage-html public/coverage --parallel",
        "architecture": "pest --filter=arch --parallel",
        "type-coverage": "pest --type-coverage --min=10 --parallel",
        "test-coverage": "pest --parallel --coverage --min=10 --parallel",
        "test": [
            "@architecture",
            "@type-coverage",
            "@test-coverage"
        ],
        "lint": "pint",
        "refactor": "rector",
        "fix": [
            "@refactor",
            "@lint"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
