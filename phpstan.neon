includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:

    paths:
        - src/

    level: 1

    checkModelProperties: true
    noEnvCallsOutsideOfConfig: true
    checkModelAppends: false
    checkUnusedViews: false
    viewDirectories:
        - resources/
